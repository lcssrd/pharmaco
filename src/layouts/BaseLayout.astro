---
/**
 * Squelette commun à toutes les pages : <head> (référencement, icônes, police, styles),
 * lien d'évitement et scripts communs.
 */
import '../styles/global.css';
import policeLatin from '../assets/polices/inter-latin-wght-normal.woff2?url';
import MesureAudience from '../components/MesureAudience.astro';
import { SITE } from '../data/site';

interface Props {
    titre: string;
    description: string;
    ogTitre: string;
    ogDescription?: string | undefined;
    ogType: 'website' | 'article';
    /** Nom du fichier de la page (index.html, antico.html), pour l'adresse canonique */
    page: string;
    classeHtml?: string;
}

const { titre, description, ogTitre, ogDescription, ogType, page, classeHtml } = Astro.props;
const base = import.meta.env.BASE_URL;
const urlCanonique = new URL(page, Astro.site).href;
---

<!doctype html>
<html lang="fr" class={classeHtml}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <title>{titre}</title>
        <meta name="description" content={description} />

        <meta property="og:title" content={ogTitre} />
        {ogDescription && <meta property="og:description" content={ogDescription} />}
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={urlCanonique} />
        <meta property="og:locale" content="fr_FR" />
        <link rel="canonical" href={urlCanonique} />

        <meta name="theme-color" content={SITE.couleurTheme} />
        <link rel="manifest" href={`${base}manifest.webmanifest`} />
        <link rel="icon" href={`${base}assets/icones/favicon.svg`} type="image/svg+xml" />
        <link rel="icon" href={`${base}assets/icones/favicon-32.png`} sizes="32x32" type="image/png" />
        <link rel="apple-touch-icon" href={`${base}assets/icones/apple-touch-icon.png`} />

        <!-- Police préchargée pour éviter le changement de police à l'affichage -->
        <link rel="preload" href={policeLatin} as="font" type="font/woff2" crossorigin />

        <slot name="head" />
        <MesureAudience />
    </head>

    <body class="p-2 sm:p-4 md:p-8">
        <a href="#contenu" class="lien-evitement">
            Aller au contenu
        </a>
        <slot />

        <script>
            import { nettoyerAncienneVersionHorsLigne } from '../scripts/hors-ligne';

            nettoyerAncienneVersionHorsLigne();
        </script>
    </body>
</html>
