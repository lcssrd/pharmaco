---
import BaseLayout from '../layouts/BaseLayout.astro';
import CarteAccueil from '../components/accueil/CarteAccueil.astro';
import Recherche from '../components/accueil/Recherche.astro';
import MenuSites from '../components/MenuSites.astro';
import ParEidosSimul from '../components/ParEidosSimul.astro';
import PiedDePage from '../components/PiedDePage.astro';
import Signature from '../components/Signature.astro';
import { LIENS_EXTERNES } from '../data/liens-externes';
import { SITE } from '../data/site';
import { THEMES_CARTES } from '../data/themes-cartes';
import { toutesLesFiches } from '../lib/serveur/fiches';

const fiches = toutesLesFiches();

// Le dernier mot du nom du site (« pharmacologie ») est mis en couleur, comme les mots-clés
// du titre de l'accueil d'Eidos-Simul
const coupure = SITE.nom.lastIndexOf(' ');
const nomDebut = SITE.nom.slice(0, coupure);
const nomFin = SITE.nom.slice(coupure + 1);

// Les cartes apparaissent l'une après l'autre (50 ms d'écart, au plus 650 ms)
const ECART_ANIMATION_MS = 50;
const DELAI_MAX_MS = 650;
const delai = (rang: number): number => Math.min(rang * ECART_ANIMATION_MS, DELAI_MAX_MS);
---

<BaseLayout
    titre="Les essentiels en pharmacologie IFSI"
    description="Portail de révision pharmacologie pour étudiants infirmiers (ESI). Accédez aux fiches de synthèse UE 2.11 : Antalgiques, Anticoagulants, Diabète, Cardio... Classées par semestre (S1, S3, S5)."
    ogTitre="Pharmacologie IFSI - Les essentiels"
    ogDescription="Toutes les fiches de pharmaco pour valider l'UE 2.11. Gratuit et accessible."
    ogType="website"
    page="index.html">
    <header class="w-full max-w-6xl mx-auto px-4 sm:px-6">
        <div class="flex justify-end pt-3 sm:pt-4">
            <MenuSites />
        </div>
        <!-- Titre et signature calée sous sa fin, comme l'accueil de Skopéo -->
        <div class="flex justify-center pt-2 pb-8 sm:pt-4 sm:pb-12 text-center">
            <div class="flex flex-col items-end">
                <!-- Deux lignes : la boîte du titre prend la largeur de la plus longue, la signature s'y cale -->
                <h1 class="font-titre font-semibold text-encre text-[clamp(2.25rem,7vw,4.75rem)] leading-[0.98] tracking-[-0.02em]">
                    <span class="block">{`${nomDebut} `}</span>
                    <span class="block text-pharma">{nomFin}</span>
                </h1>
                <!-- « par Eidos-Simul.fr », la même signature que sous le titre de Skopéo -->
                <p class="signature-amorce mt-4 sm:mt-5 mr-[0.15em] text-[clamp(0.95rem,1.8vw,1.15rem)] leading-none whitespace-nowrap">
                    <ParEidosSimul />
                </p>
            </div>
        </div>
    </header>

    <main id="contenu" class="w-full max-w-6xl mx-auto px-4 sm:px-6 pb-12 md:pb-16 grow">
        <Recherche />

        <ul
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 auto-rows-[1fr]"
            aria-label="Fiches de révision">
            {fiches.map((fiche, rang) => (
                <CarteAccueil
                    href={`${fiche.slug}.html`}
                    fiche={fiche.slug}
                    titre={fiche.carte.titre}
                    sousTitre={fiche.carte.sousTitre}
                    pastille={fiche.carte.semestre}
                    theme={THEMES_CARTES[fiche.carte.couleur]}
                    icone={fiche.carte.icone}
                    delai={delai(rang)}
                />
            ))}
            {LIENS_EXTERNES.map((lien, i) => (
                <CarteAccueil
                    href={lien.url}
                    externe
                    titre={lien.titre}
                    sousTitre={lien.sousTitre}
                    pastille={lien.pastille}
                    theme={lien.theme}
                    icone={lien.icone}
                    delai={delai(fiches.length + i)}
                />
            ))}
        </ul>
    </main>

    <PiedDePage>
        <p class="text-sm">
            <Signature version />
        </p>
        <p slot="droite" class="text-xs text-attenue">
            Contenu sous licence{' '}
            <a
                href={SITE.licence.url}
                target="_blank"
                rel="noopener"
                class="font-semibold text-pharma underline-offset-2 hover:underline">
                {SITE.licence.nom}
            </a>
        </p>
    </PiedDePage>

    <script>
        import { afficherScoresAccueil } from '../scripts/scores-accueil';

        afficherScoresAccueil();
    </script>
</BaseLayout>
