---
/** Recherche dans toutes les fiches (index produit par src/pages/recherche.json.ts) */
const urlIndex = `${import.meta.env.BASE_URL}recherche.json`;
---

<div class="max-w-2xl mx-auto mb-8 sm:mb-10" role="search" data-recherche={urlIndex}>
    <label for="champ-recherche" class="sr-only">
        Rechercher dans toutes les fiches
    </label>
    <div class="relative">
        <svg
            class="pointer-events-none absolute left-5 top-1/2 -translate-y-1/2 w-5 h-5 text-pharma"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input
            id="champ-recherche"
            type="search"
            autocomplete="off"
            spellcheck="false"
            enterkeyhint="search"
            aria-controls="resultats-recherche"
            placeholder="Rechercher : Lovenox, INR, morphine…"
            class="w-full h-14 pl-13 pr-5 rounded-full border-2 border-white bg-white text-encre placeholder:text-indice shadow-pastille focus:outline-hidden focus:border-pharma focus:shadow-bleu transition"
        />
    </div>
    <!-- Annonce du nombre de résultats aux lecteurs d'écran -->
    <p class="sr-only" aria-live="polite" data-recherche-statut></p>
    <div id="resultats-recherche" class="mt-3" hidden></div>
</div>

<script>
    import { initialiserRecherche } from '../../scripts/recherche';

    const zone = document.querySelector<HTMLElement>('[data-recherche]');
    if (zone) initialiserRecherche(zone);
</script>
