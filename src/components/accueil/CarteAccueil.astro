---
/** Carte de l'accueil : une fiche, ou un lien externe */
import type { ThemeCarte } from '../../data/themes-cartes';

interface Props {
    href: string;
    titre: string;
    sousTitre?: string | undefined;
    pastille: string;
    theme: ThemeCarte;
    /** Tracé SVG de l'icône (grille 256 × 256) */
    icone: string;
    /** Délai de l'animation d'apparition, en millisecondes */
    delai: number;
    /** Identifiant de la fiche : la pastille du meilleur score au quiz s'y ajoute */
    fiche?: string;
    /** Lien vers un autre site, ouvert dans un nouvel onglet */
    externe?: boolean;
}

const { href, titre, sousTitre, pastille, theme, icone, delai, fiche, externe = false } = Astro.props;
---

<li>
    <a
        href={href}
        data-fiche={fiche}
        target={externe ? '_blank' : undefined}
        rel={externe ? 'noopener' : undefined}
        class:list={[
            'card-enter group flex flex-col p-4 rounded-xl border bg-linear-to-br hover:shadow-2xl hover:-translate-y-2 hover:ring-2 transition-all duration-300 h-full',
            theme.carte,
        ]}
        style={delai ? `animation-delay: ${delai}ms;` : undefined}>
        <div class="flex justify-between items-start">
            <svg
                class:list={['shrink-0 text-3xl group-hover:scale-110 transition-transform duration-300', theme.accent]}
                width="1em"
                height="1.2em"
                viewBox="0 0 256 256"
                fill="currentColor"
                aria-hidden="true"
                focusable="false">
                <path d={icone}></path>
            </svg>
            <span
                class:list={[
                    'font-bold py-1 rounded-full group-hover:scale-110 transition-transform duration-300',
                    theme.pastille,
                ]}>
                {pastille}
            </span>
        </div>
        <div class="mt-3 grow" data-carte-texte>
            <h2 class="font-bold text-slate-800 group-hover:scale-105 origin-left transition-transform duration-300">
                {titre}
                {externe && <span class="sr-only"> (nouvel onglet)</span>}
            </h2>
            {sousTitre && <p class="text-xs text-slate-600 mt-1">{sousTitre}</p>}
        </div>
        <div class="mt-2 text-right h-5">
            <span
                class:list={[
                    'opacity-0 group-hover:opacity-100 transition-opacity font-black text-2xl leading-none',
                    theme.accent,
                ]}
                aria-hidden="true">
                →
            </span>
        </div>
    </a>
</li>
