---
/**
 * Barre d'onglets d'une fiche (motif « onglets » des WAI-ARIA Authoring Practices).
 * L'apparence de l'onglet actif découle de aria-selected : le script n'a qu'à changer cet attribut.
 */
import type { Onglet } from '../../types/fiche';

interface Props {
    onglets: Onglet[];
    /** Classes de colonnes de la grille */
    grille: string;
}

const { onglets, grille } = Astro.props;
---

<div class="pt-6 sm:pt-8">
    <div
        role="tablist"
        aria-label="Sections de la fiche"
        class:list={['p-1.5 bg-white rounded-[1.75rem] shadow-pastille grid gap-1.5', grille]}
        data-onglets>
        {onglets.map((onglet, i) => (
            <button
                type="button"
                role="tab"
                id={`onglet-${onglet.id}`}
                aria-controls={onglet.id}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                class:list={[
                    'nav-btn w-full py-3 px-2 rounded-[1.375rem] text-encre font-semibold transition-all duration-300 text-xs sm:text-sm',
                    'aria-selected:bg-linear-to-r aria-selected:text-white aria-selected:shadow-md',
                    onglet.actif,
                    onglet.survol ?? 'hover:bg-controle',
                ]}>
                {onglet.libelle}
            </button>
        ))}
    </div>
</div>

<script>
    import { initialiserOnglets } from '../../scripts/onglets';

    const liste = document.querySelector<HTMLElement>('[data-onglets]');
    if (liste) initialiserOnglets(liste);
</script>
