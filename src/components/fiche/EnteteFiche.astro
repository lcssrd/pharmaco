---
import type { FicheChargee } from '../../lib/serveur/fiches';
import Signature from '../Signature.astro';
import ListeOnglets from './ListeOnglets.astro';

interface Props {
    fiche: FicheChargee;
}

const { fiche } = Astro.props;
const { apparence } = fiche;

const COLLANT = {
    'z-10': 'sticky top-0 z-10',
    'z-20': 'sticky top-0 z-20',
    'z-50': 'sticky top-0 z-50',
} as const;
---

<header
    class:list={['bg-slate-800 text-white p-6 md:p-8', apparence.enteteCollant && COLLANT[apparence.enteteCollant]]}>
    <div class="flex flex-col-reverse gap-3 md:flex-row md:items-center md:justify-between">
        <h1
            class:list={[
                'text-3xl sm:text-4xl md:text-5xl font-black tracking-tight bg-linear-to-r bg-clip-text text-transparent pb-2',
                apparence.titre,
            ]}>
            {fiche.titre}
        </h1>
        <div class="shrink-0 flex flex-col gap-2 md:items-end">
            <div class="flex items-center gap-2">
                <a href="index.html" class="bouton-entete mr-auto md:mr-0">
                    <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true">
                        <path d="m12 19-7-7 7-7"></path>
                        <path d="M19 12H5"></path>
                    </svg>
                    <span>Toutes les fiches</span>
                </a>
            </div>
            <div class="hidden md:flex text-right font-bold text-slate-300 text-sm">
                <p>
                    <Signature classe={`bg-linear-to-r bg-clip-text text-transparent ${apparence.auteurEntete}`} />
                </p>
            </div>
        </div>
    </div>

    <ListeOnglets onglets={fiche.onglets} grille={apparence.grilleOnglets} />
</header>
