---
/**
 * En-tête d'une fiche, au dessin d'Eidos-Simul : barre blanche collante (retour à l'accueil,
 * menu des autres sites), puis le titre de la fiche et la barre d'onglets.
 */
import type { FicheChargee } from '../../lib/serveur/fiches';
import MenuSites from '../MenuSites.astro';
import ListeOnglets from './ListeOnglets.astro';

interface Props {
    fiche: FicheChargee;
}

const { fiche } = Astro.props;
const { apparence } = fiche;
---

<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center gap-3">
        <a href="index.html" class="bouton-retour mr-auto">
            <span class="bouton-retour__icone" aria-hidden="true">
                <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="m12 19-7-7 7-7"></path>
                    <path d="M19 12H5"></path>
                </svg>
            </span>
            <span>Toutes les fiches</span>
        </a>
        <MenuSites />
    </div>
</header>

<div class="w-full max-w-6xl mx-auto px-3 sm:px-6 pt-8 sm:pt-12">
    <h1
        class:list={[
            'w-fit px-1 sm:px-0 pb-1 font-titre font-semibold text-[clamp(2rem,5.2vw,3.75rem)] leading-[1.05] tracking-[-0.02em] text-balance bg-linear-to-r bg-clip-text text-transparent',
            apparence.titre,
        ]}>
        {fiche.titre}
    </h1>

    <ListeOnglets onglets={fiche.onglets} grille={apparence.grilleOnglets} />
</div>
