---
import type { FicheChargee } from '../../lib/serveur/fiches';
import PiedDePage from '../PiedDePage.astro';
import Signature from '../Signature.astro';

interface Props {
    fiche: FicheChargee;
}

const { fiche } = Astro.props;

// Date écrite en AAAA-MM-JJ, affichée « 25 novembre 2026 » (en UTC : pas de décalage d'un jour)
const dateLisible = new Date(`${fiche.miseAJour}T00:00:00Z`).toLocaleDateString('fr-FR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
});
---

<PiedDePage>
    <p class="text-sm font-medium text-encre">
        Dernière mise à jour du contenu : <time datetime={fiche.miseAJour}>{dateLisible}</time>
    </p>
    <p class="mt-1.5 max-w-2xl text-xs leading-relaxed text-attenue">
        Support de révision à visée pédagogique : il ne remplace ni les cours de votre IFSI, ni le résumé des
        caractéristiques du produit (RCP) des médicaments, ni une prescription médicale.
    </p>
    <p slot="droite" class="text-sm">
        <Signature />
    </p>
</PiedDePage>
